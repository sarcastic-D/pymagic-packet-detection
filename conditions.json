        }
      },
      {
        "id": "b2",
        "description": "ICMP ECHO magic 0x7255",
        "protocol": "ICMP",
        "match": {
          "payload_magic": "0x7255"
        }
      },
      {
        "id": "b3",
        "description": "TCP magic 0x5293 + password",
        "protocol": "TCP",
        "match": {
          "payload_magic": "0x5293",
          "password": "justrobot"
        }
      }
    ]
  },

